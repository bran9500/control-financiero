<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/w_label"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Te falta esta semana"
            android:textColor="#8B93A0"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/w_updated"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#5B6472"
            android:textSize="10sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/w_main"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="—"
        android:textColor="#C4693B"
        android:textSize="30sp"
        android:fontFamily="monospace" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Entró" android:textColor="#8B93A0" android:textSize="11sp" />
            <TextView android:id="@+id/w_in" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="#6FA98A" android:textSize="15sp" android:fontFamily="monospace" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Gastado" android:textColor="#8B93A0" android:textSize="11sp" />
            <TextView android:id="@+id/w_out" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="#E8E6E0" android:textSize="15sp" android:fontFamily="monospace" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Saldo" android:textColor="#8B93A0" android:textSize="11sp" />
            <TextView android:id="@+id/w_bal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="#E8E6E0" android:textSize="15sp" android:fontFamily="monospace" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/w_next"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:text=""
        android:textColor="#E8E6E0"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">
        <TextView android:id="@+id/w_btn_rot" android:layout_width="0dp" android:layout_weight="1" android:layout_height="34dp" android:layout_marginEnd="6dp" android:background="@drawable/widget_btn" android:gravity="center" android:text="Rotador" android:textColor="#E8E6E0" android:textSize="12sp" />
        <TextView android:id="@+id/w_btn_bot" android:layout_width="0dp" android:layout_weight="1" android:layout_height="34dp" android:layout_marginEnd="6dp" android:background="@drawable/widget_btn" android:gravity="center" android:text="Bot" android:textColor="#E8E6E0" android:textSize="12sp" />
        <TextView android:id="@+id/w_btn_notes" android:layout_width="0dp" android:layout_weight="1" android:layout_height="34dp" android:layout_marginEnd="6dp" android:background="@drawable/widget_btn" android:gravity="center" android:text="Notas" android:textColor="#E8E6E0" android:textSize="12sp" />
        <TextView android:id="@+id/w_btn_dict" android:layout_width="0dp" android:layout_weight="1" android:layout_height="34dp" android:background="@drawable/widget_btn" android:gravity="center" android:text="🎤 Dictar" android:textColor="#6FA98A" android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
